import pandas as pd
import matplotlib.pyplot as plt

from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans, AgglomerativeClustering
from sklearn.metrics import silhouette_score

df = pd.read_csv("Mall_Customers.csv")

X = df[["Annual Income (k$)", "Spending Score (1-100)"]]

scaler = StandardScaler()
X = scaler.fit_transform(X)

scores = []

for k in range(2, 11):
    model = KMeans(n_clusters=k, random_state=42, n_init=10)
    labels = model.fit_predict(X)
    scores.append(silhouette_score(X, labels))

kmeans = KMeans(n_clusters=5, random_state=42, n_init=10)
k_labels = kmeans.fit_predict(X)

agg = AgglomerativeClustering(n_clusters=5, linkage="ward")
a_labels = agg.fit_predict(X)

print("K-Means Inertia:", kmeans.inertia_)
print("K-Means Silhouette:", silhouette_score(X, k_labels))
print("Agglomerative Silhouette:", silhouette_score(X, a_labels))

plt.figure(figsize=(15, 4))

plt.subplot(1, 3, 1)
plt.plot(range(2, 11), scores, marker="o")
plt.title("Silhouette Score")
plt.xlabel("Number of Clusters")
plt.ylabel("Score")
plt.grid()

plt.subplot(1, 3, 2)
plt.scatter(X[:, 0], X[:, 1], c=k_labels)
plt.title("K-Means Clustering")
plt.xlabel("Annual Income")
plt.ylabel("Spending Score")

plt.subplot(1, 3, 3)
plt.scatter(X[:, 0], X[:, 1], c=a_labels)
plt.title("Agglomerative Clustering")
plt.xlabel("Annual Income")
plt.ylabel("Spending Score")

plt.tight_layout()
plt.show()
